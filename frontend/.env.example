# Backend API URL (HTTPS with DuckDNS domain)
VITE_API_BASE_URL=https://yourname.duckdns.org

# Frontend will be accessible at:
# - HTTPS: https://yourname.duckdns.org
# - HTTP: http://yourname.duckdns.org (redirects to HTTPS)

# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# R14d cutover build gate (Vite build-time setting; baked into the bundle).
# Allowed values: "false" (pre-cutover / rollback artifact — Dashboard,
# global store, and the global /ws client keep their existing behavior)
# or "true" (post-R14c artifact — RoomEntry is the authenticated landing
# surface, the Dashboard route is absent, legacy global runtime state is
# retired at bootstrap, and the global /ws client cannot connect).
# Missing or empty selects false. Any other value fails the build
# explicitly. The "true" artifact must NOT be deployed before the R14c
# maintenance window.
VITE_ROOM_CUTOVER_AUTHORITATIVE=false
