#FRONTEND CONFIGURATION
FRONTEND_HTTP_PORT=8011
FRONTEND_HTTPS_PORT=8012

#BACKEND CONFIGURATION
BACKEND_PORT=1111

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Role Configuration (comma-separated emails)
HOST_EMAILS=host@example.com
ADMIN_EMAILS=admin@example.com

# DuckDNS Configuration for HTTPS
DUCKDNS_DOMAIN=yourname.duckdns.org
DUCKDNS_TOKEN=your-duckdns-token-here
LETSENCRYPT_EMAIL=your-email@example.com

# ----------------------------------------------------------------------------
# PostgreSQL configuration.
#
# WARNING: devpassword below is committed for local development convenience
# ONLY. Do NOT use these values in production, staging, or any environment
# reachable from the public internet. In production set DATABASE_URL from a
# managed secret manager and use sslmode=require (or verify-full).
#
# The server refuses to start without DATABASE_URL (R03).
# ----------------------------------------------------------------------------

# Full DSN — preferred. Takes precedence over the POSTGRES_* overrides.
# Example (production): postgres://user:REDACTED@db.example.com:5432/lmq?sslmode=verify-full
DATABASE_URL=postgres://lmq:devpassword@localhost:5432/lmq?sslmode=disable

# Individual overrides — used only when DATABASE_URL is empty.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=lmq
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=lmq
POSTGRES_SSLMODE=disable

# ----------------------------------------------------------------------------
# Allowed origins (A01)
#
# Comma-separated list of fully-qualified origins permitted to call the API
# and open the WebSocket. The same list is used for HTTP CORS and WebSocket
# upgrades — there is no longer a wildcard CORS fallback. In APP_ENV=local
# the server falls back to loopback defaults (localhost / 127.0.0.1 on the
# configured ports) when this is empty; in any other environment the server
# refuses to start without a non-empty list.
#
# Example (production):
# ALLOWED_ORIGINS=https://music.example.com,https://admin.example.com
# ----------------------------------------------------------------------------
# ALLOWED_ORIGINS=