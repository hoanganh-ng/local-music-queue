#FRONTEND CONFIGURATION
FRONTEND_HTTP_PORT=8011
FRONTEND_HTTPS_PORT=8012

#BACKEND CONFIGURATION
BACKEND_PORT=1111

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Role Configuration (comma-separated emails)
HOST_EMAILS=host@example.com
ADMIN_EMAILS=admin@example.com

# DuckDNS Configuration for HTTPS
DUCKDNS_DOMAIN=yourname.duckdns.org
DUCKDNS_TOKEN=your-duckdns-token-here
LETSENCRYPT_EMAIL=your-email@example.com

# ----------------------------------------------------------------------------
# PostgreSQL configuration (R02 — dev-only defaults).
#
# WARNING: devpassword below is committed for local development convenience
# ONLY. Do NOT use these values in production, staging, or any environment
# reachable from the public internet. In production set DATABASE_URL from a
# managed secret manager and use sslmode=require (or verify-full).
#
# When DATABASE_URL is set, the backend uses PostgreSQL and ignores DB_PATH.
# When DATABASE_URL is empty, the backend falls back to DB_PATH (SQLite).
# ----------------------------------------------------------------------------

# Full DSN — preferred. Takes precedence over the POSTGRES_* overrides.
# Example (production): postgres://user:REDACTED@db.example.com:5432/lmq?sslmode=verify-full
DATABASE_URL=postgres://lmq:devpassword@localhost:5432/lmq?sslmode=disable

# Individual overrides — used only when DATABASE_URL is empty.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=lmq
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=lmq
POSTGRES_SSLMODE=disable

# SQLite fallback (R02/R03 only — removed by R03 once data migration is verified).
DB_PATH=./.localdb/music_queue.db